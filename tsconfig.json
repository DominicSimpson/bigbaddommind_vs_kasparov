{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],

    "rootDir": ".",
    "outDir": "./dist",

    "strict": true,
    "esModuleInterop": true,

    "types": ["node", "vitest/globals"],

    "skipLibCheck": true
  },
  
"include": ["src", "tests", "ui", "vite.config.ts", "playwright.config.ts"]
}

